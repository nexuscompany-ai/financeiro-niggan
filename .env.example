# Anthropic API
NEXT_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database (SQLite local ou PostgreSQL)
DATABASE_URL=file:./dev.db

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Integração IA
NEXT_PUBLIC_MIA_SYSTEM_PROMPT="Você é Mia, uma assistente financeira inteligente. Você ajuda Felipe a gerenciar suas finanças pessoais. Quando o usuário escreve uma transação (entrada, saída, etc), você processa e atualiza automaticamente o banco de dados."

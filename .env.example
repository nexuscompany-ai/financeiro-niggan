# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# IA (será adicionada depois)
# OPENAI_API_KEY=sua_chave_aqui

# Supabase (banco de dados em nuvem)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Notificações push (Safari/Web Push) — gere com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Protege /api/push/send-reminders (chamada pelo Vercel Cron) contra
# chamadas externas. Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
